FROM python@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS builder
WORKDIR /build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM docker:28.5.1-cli AS docker-cli
FROM python@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 --create-home aegis
COPY --from=builder /install /usr/local
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /srv/backend
COPY --chown=aegis:aegis backend/app ./app
COPY --chown=aegis:aegis evals /srv/evals
RUN mkdir -p /srv/backend/data /srv/worker-data && chown -R aegis:aegis /srv/backend/data /srv/worker-data
USER aegis
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=4s --start-period=15s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["uvicorn", "app.v2.api:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8000"]
