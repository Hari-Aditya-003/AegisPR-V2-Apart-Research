# Save a private copy as .env.v2, mode 0600. Never commit provider credentials.
API_ACCESS_TOKEN=
V2_WORKER_TOKEN=
V2_WORKER_PUBLIC_KEY=
DOCKER_GID=999
PUBLIC_API_URL=http://localhost:8200
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
NEBIUS_API_KEY=
VULTR_API_KEY=
V2_ENABLE_MODELS=false
V2_BUDGET_USD=1
V2_RUN_BUDGET_USD=0.03
V2_MAX_CALLS=3
V2_ALLOWED_REPOSITORIES=Hari-Aditya-003/AegisPR-V2-Apart-Research
# Optional: existing authenticated CUDA ranker; never expose its token in frontend code.
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
